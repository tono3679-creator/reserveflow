# ReserveFlow の環境変数（このファイルをコピーして .env.local を作る。.env.local は Git にコミットしない）

# PostgreSQL の接続文字列（Supabase：Project Settings → Database → Connection string → Transaction pooler）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reserveflow
# マイグレーション用の直接接続（任意。Supabase の Direct connection / Session pooler）
DATABASE_URL_UNPOOLED=

# 認証：supabase（Supabase Auth）または local（アプリ内のログイン。開発・テスト用）
AUTH_PROVIDER=local
# Supabase Auth を使うときだけ（Project Settings → API）。anon key は公開してよい鍵
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 見本の企業のログイン用パスワード（npm run db:seed のときだけ使う。12文字以上）
SEED_LOGIN_PASSWORD=

# 予約の確認・変更リンクを作る秘密の値（32文字以上のランダムな値。本番では必須。変えると発行済みのリンクは使えなくなる）
# 例：openssl rand -base64 48
APP_SECRET=
# 通知の本文に入れるリンクの基準 URL（例：https://reserveflow.example.com。Vercel では本番 URL を自動で使う）
APP_URL=http://localhost:3000

# メール送信（任意・Resend）。空のままなら送信せず、通知管理の画面で「デモ通知」として内容を確認できる
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=

# Vercel Cron の認証（16文字以上のランダムな値）
CRON_SECRET=

# デモの上限（任意）
DEMO_MAX_ACTIVE=50
DEMO_CREATE_LIMIT_PER_HOUR=20
# 同じ接続元から1時間に受け付ける公開予約の数（変更・キャンセルはこの2倍）
PUBLIC_BOOKING_LIMIT_PER_HOUR=10
